# Copy to .env and fill in real values. NEVER commit the real .env.

# --- RDP connection (required) ---
RDP_HOST=host.example.com
RDP_USER=your-username
RDP_PASSWORD=your-password
RDP_DOMAIN=YOUR_DOMAIN

# --- login timing (optional) ---
# RENDER_WAIT=8      # seconds to wait for session to render before pressing Enter
# HOLD_AFTER=20      # seconds to keep session open after Enter (lets Startup items launch)

# --- run mode ---
# MODE=once          # (default) run one login and exit — for manual / one-shot use
# MODE=webhook       # run an event-driven listener that triggers login on a matching webhook

# --- webhook mode settings (only used when MODE=webhook) ---
# WEBHOOK_PORT=8080          # listen port inside the container
# WEBHOOK_PATH=/trigger      # only accept POSTs to this path
# WEBHOOK_TOKEN=             # if set, require ?token=... on the request (recommended)
# MATCH_RULES=               # rules separated by ';', keywords by ','; triggers if ANY rule
#                            # matches (all its keywords present). preferred over MATCH_KEYWORDS.
#                            # e.g. fire on either a VM going offline OR a host coming online:
#                            # MATCH_RULES=My VM,down ; My Host,up
# MATCH_KEYWORDS=up          # legacy single-rule form (all keywords required); used only if
#                            # MATCH_RULES is unset. e.g. MATCH_KEYWORDS=My Host,up
# MATCH_FIELD=               # JSON key to read text from; empty = match against whole body
# TRIGGER_DELAY=40           # seconds to wait after event before logging in
# TRIGGER_COOLDOWN=120       # min seconds between two triggers (debounce)
